<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- JSch 是 docker-java 的 SSH 传输层（docker-java-transport-jsch）的底层库，
         INFO 级别下会为每次连接/握手/SFTP 通道打印大量协议细节，SSH 主机多的时候控制台会被刷屏。
         只保留 WARN 及以上（连接失败、认证失败、主机密钥问题仍能看到）。 -->
    <logger name="com.jcraft.jsch" level="WARN"/>

    <!-- 文件日志（构建、部署、镜像同步/导出等）由 open-admin 框架的
         logviewer FileLogConfig 以编程方式注册（FILE-LOGGER + SiftingAppender，
         MDC key FILE_LOG_ID），写入 ${logging.file.path}/{logId}.log。 -->

</configuration>
