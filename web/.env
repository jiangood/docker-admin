PORT=8090
SERVLET_CONTEXT=/docker-admin
# SERVER_PORT=8080

# ============================================
# Theme customization (optional)
# Uncomment to customize system theme colors.
# Setting THEME_PRIMARY_COLOR will auto-derive hover/click variants.
# ============================================
# THEME_PRIMARY_COLOR=#1961AC
# THEME_SUCCESS_COLOR=#52c41a
# THEME_WARNING_COLOR=#faad14
# THEME_ERROR_COLOR=#ff4d4f
# THEME_BACKGROUND_COLOR=#f5f5f5

# ============================================
# Public pages (optional)
# Comma-separated paths that don't require login/layout.
# Use /** suffix for prefix matching (e.g., /test/** matches /test/foo).
# Default: /login,/test
# ============================================
# PUBLIC_PAGES=/login,/test/**