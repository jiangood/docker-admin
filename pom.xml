<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
    </parent>
    <groupId>io.github.jiangood</groupId>
    <artifactId>docker-admin</artifactId>
    <version>4.8.125</version>
    <name>docker-admin</name>

    <properties>
        <java.version>21</java.version>

        <!-- 依赖版本集中管理：同类依赖共用属性，便于 dependabot 批量升级并避免版本漂移 -->
        <open-admin.version>3.4.1-SNAPSHOT</open-admin.version>

        <!-- hutool 各模块须同版本（由 open-admin 传递引入）；改动前用 mvn dependency:tree -Dincludes=cn.hutool 核对 -->
        <hutool.version>5.8.48</hutool.version>

        <!-- docker-java 核心与 HTTP 传输层必须同版本 -->
        <docker-java.version>3.7.1</docker-java.version>

        <!-- SSH 传输层 1.4 构建目标为 docker-java-core 3.4.0；1.5 尚未发布，升级后必须实测远程 SSH 连接 -->
        <docker-java-jsch.version>1.4</docker-java-jsch.version>

        <!-- 显式声明 JSch（SSH 预检直接使用）；版本须与传输层传递依赖一致（1.4 对应 2.27.7） -->
        <jsch.version>2.27.7</jsch.version>

        <jgit.version>7.8.0.202609011348-r</jgit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.jiangood</groupId>
                <artifactId>open-admin</artifactId>
                <version>${open-admin.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-system</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java</artifactId>
                <version>${docker-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java-transport-httpclient5</artifactId>
                <version>${docker-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.mwiede.dockerjava</groupId>
                <artifactId>docker-java-transport-jsch</artifactId>
                <version>${docker-java-jsch.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.mwiede</groupId>
                <artifactId>jsch</artifactId>
                <version>${jsch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit.ssh.apache</artifactId>
                <version>${jgit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- SNAPSHOT 预览版依赖在 Central 快照仓库；正式版无需此仓库 -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled><updatePolicy>always</updatePolicy></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.github.jiangood</groupId>
            <artifactId>open-admin</artifactId>
        </dependency>

        <!-- 内置数据库：默认使用 H2（文件模式），开箱即用，无需外部 MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>


        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-system</artifactId>
        </dependency>



        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <!-- 版本由 spring-boot-starter-parent 管理，此处不覆盖以免与其产生版本倒挂 -->
        </dependency>


        <!-- https://mvnrepository.com/artifact/com.github.docker-java/docker-java -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java</artifactId>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.github.docker-java/docker-java-transport-httpclient5 -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-httpclient5</artifactId>
        </dependency>

        <!-- 通过 SSH 连接远程 docker（docker system dial-stdio），无需暴露 2375 -->
        <dependency>
            <groupId>com.github.mwiede.dockerjava</groupId>
            <artifactId>docker-java-transport-jsch</artifactId>
        </dependency>

        <!-- 主机「测试连接」的 SSH 预检：先判断远端有没有 docker、daemon 是否可达 -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
        </dependency>


        <!-- https://mvnrepository.com/artifact/org.eclipse.jgit/org.eclipse.jgit -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>

        <!-- 支持用 SSH 私钥（git@host:path）克隆代码，JGit 官方维护的 sshd 实现 -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit.ssh.apache</artifactId>
        </dependency>






        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>




</project>
